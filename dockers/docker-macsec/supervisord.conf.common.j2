{# supervisord.conf.common.j2 — shared macsec supervisord programs
   Used by docker-sonic-vs via _INCLUDE_DOCKER.
   Variables:
     macsec_priority_base  — base priority for macsec programs (default 2)
     use_dependent_startup — enable dependent_startup (default false)
     macsec_wait_for       — what to wait for before starting (default "rsyslogd:running")
   Note: macsecmgrd ships in the swss deb, which docker-sonic-vs already
   installs. Only wpa_supplicant and this supervision entry are contributed
   by the macsec feature docker.
#}
{% set macsec_priority_base = macsec_priority_base | default(2) %}
{% set use_dependent_startup = use_dependent_startup | default(false) %}
{% set macsec_wait_for = macsec_wait_for | default("rsyslogd:running") %}

[program:macsecmgrd]
command=/usr/bin/macsecmgrd
priority={{ macsec_priority_base }}
autostart=false
autorestart=false
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
{% if ENABLE_ASAN is defined and ENABLE_ASAN == "y" %}
environment=ASAN_OPTIONS="log_path=/var/log/asan/macsecmgrd-asan.log{{ asan_extra_options }}"
{% endif %}
{% if use_dependent_startup %}
dependent_startup=true
dependent_startup_wait_for={{ macsec_wait_for }}
{% endif %}
